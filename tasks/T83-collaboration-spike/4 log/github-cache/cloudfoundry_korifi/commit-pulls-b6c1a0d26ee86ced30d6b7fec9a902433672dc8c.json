    "number": 626,
    "state": "closed",
    "locked": true,
    "title": "Remove ResourceNotFoundError and PermissionDeniedOrNotFoundError from repositories",
    "user": {
      "login": "kieron-dev",
      "id": 30794658,
      "node_id": "MDQ6VXNlcjMwNzk0NjU4",
      "avatar_url": "https://avatars.githubusercontent.com/u/30794658?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/kieron-dev",
      "html_url": "https://github.com/kieron-dev",
      "followers_url": "https://api.github.com/users/kieron-dev/followers",
      "following_url": "https://api.github.com/users/kieron-dev/following{/other_user}",
      "gists_url": "https://api.github.com/users/kieron-dev/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/kieron-dev/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/kieron-dev/subscriptions",
      "organizations_url": "https://api.github.com/users/kieron-dev/orgs",
      "repos_url": "https://api.github.com/users/kieron-dev/repos",
      "events_url": "https://api.github.com/users/kieron-dev/events{/privacy}",
      "received_events_url": "https://api.github.com/users/kieron-dev/received_events",
      "type": "User",
